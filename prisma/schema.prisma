// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserSettings {
  userId   String @id
  currency String
}

model Category {
  createdAt DateTime @default(now())
  name      String
  userId    String
  icon      String
  type      String   @default("income")

  @@unique([name, userId, type])
}

model Transaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updateAt  DateTime @default(now())

  amount      Float
  description String
  date        DateTime
  userId      String
  type        String   @default("income")

  category     String
  categoryIcon String

  budgetId   String? // Tham chiếu đến Budget
  budget     Budget? @relation(fields: [budgetId], references: [id])
  
  goalId     String? // Tham chiếu đến Goal
  goal       Goal? @relation(fields: [goalId], references: [id])
  
  loanId     String? // Tham chiếu đến Loan
  loan       Loan? @relation(fields: [loanId], references: [id])
}

model MonthHistory {
  userId  String
  day     Int
  month   Int
  year    Int
  income  Float
  expense Float

  @@id([day, month, year, userId])
}

model YearHistory {
  userId  String
  month   Int
  year    Int
  income  Float
  expense Float

  @@id([month, year, userId])
}

model Goal {
  id           String   @id @default(uuid())
  userId       String
  name         String
  targetAmount Float
  contributed  Float    @default(0)
  description  String?
  targetDate   DateTime
  createdAt    DateTime @default(now())
  isCompleted  Boolean  @default(false)
  priority     String   @default("medium") // low, medium, high
  category     String?
  
  transactions Transaction[]
}

model Loan {
  id           String   @id @default(uuid())
  userId       String
  name         String
  totalAmount  Float
  paidAmount   Float    @default(0)
  description  String?
  dueDate      DateTime
  overdue      Boolean  @default(false)
  createdAt    DateTime @default(now())
  interestRate Float?   // Annual interest rate
  loanType     String   @default("personal") // personal, mortgage, car, etc.
  status       String   @default("active") // active, paid, defaulted
  
  repaymentSchedules RepaymentSchedule[]
  transactions Transaction[]
}

model RepaymentSchedule {
  id         String   @id @default(uuid())
  loanId     String
  dueDate    DateTime
  amount     Float
  paidAmount Float    @default(0)
  status     String   @default("pending") // pending, paid, overdue
  createdAt  DateTime @default(now())
  paidAt     DateTime?
  
  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  
  @@unique([loanId, dueDate])
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  name        String
  amount      Float
  spent       Float    @default(0)
  description String?
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  category    String?
  isActive    Boolean  @default(true)
  alertThreshold Float? // Alert when spent reaches this percentage

  transactions Transaction[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // info, warning, error, success
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt    DateTime?
  
  // Optional references to related entities
  goalId    String?
  loanId    String?
  budgetId  String?
  
  @@index([userId, isRead])
  @@index([createdAt])
}

